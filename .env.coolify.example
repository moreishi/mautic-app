# Copy to Coolify environment variables (do NOT commit real secrets).
# In Coolify: Project > Environment > mautic stack > Environment Variables, paste these keys.
APP_ENV=prod
APP_DEBUG=0

# MySQL 8.4 (Mautic 7 requires MySQL 8.4+ or MariaDB 10.11+)
MYSQL_DATABASE=mautic
MYSQL_USER=mautic
MYSQL_PASSWORD=change-me-32-chars-min
MYSQL_ROOT_PASSWORD=change-me-root-32-chars-min

# Mautic first-install (entrypoint generates config/local.php if missing)
MAUTIC_SITE_URL=https://mautic.yourdomain.com
MAUTIC_ADMIN_EMAIL=mautic@yourdomain.com
MAUTIC_ADMIN_PASSWORD=change-me-admin-password
MAUTIC_MAILER_DSN=smtp://localhost:1025

# Set false on redeploys if you manage migrations manually
DOCKER_MAUTIC_RUN_MIGRATIONS=true

# Messenger worker concurrency
DOCKER_MAUTIC_WORKERS_CONSUME_EMAIL=2
DOCKER_MAUTIC_WORKERS_CONSUME_HIT=2
DOCKER_MAUTIC_WORKERS_CONSUME_FAILED=2
